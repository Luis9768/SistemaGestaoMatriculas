# ==============================================================================
# SIGMA - Variáveis de Ambiente para Deploy (Easypanel / Docker / Nuvem)
# ==============================================================================

# --- BANCO DE DADOS (POSTGRESQL) ---
# Se usar o PostgreSQL 1-Click do Easypanel ou Supabase/Neon, você pode fornecer:
# OPÇÃO A: A URL completa de conexão fornecida pelo Easypanel/Nuvem:
# DATABASE_URL=postgresql://postgres:senha123@postgres:5432/gestao_matriculas
# OPÇÃO B: Componentes separados:
POSTGRES_DB=gestao_matriculas
POSTGRES_USER=matriculas_user
POSTGRES_PASSWORD=matriculas_pass
POSTGRES_PORT=5432

# --- BACKEND (SPRING BOOT 3 / JAVA 21) ---
SPRING_PROFILES_ACTIVE=prod
# CORS: Permite que seu frontend na nuvem se comunique com a API sem bloqueios
# Use '*' para testes ou liste os domínios separados por vírgula: https://meusite.com,https://api.meusite.com
CORS_ALLOWED_ORIGINS=*

# Senha inicial para o usuário luis@email.com (gerado se o banco estiver vazio)
INITIAL_USER_PASSWORD=admin123

# --- CACHE (REDIS OU CAFFEINE EM MEMÓRIA) ---
# Se você tiver um serviço Redis no Easypanel, use 'redis':
SPRING_CACHE_TYPE=redis
REDIS_HOST=redis
REDIS_PORT=6379
# Se NÃO quiser rodar Redis na nuvem para economizar memória na VPS, troque para:
# SPRING_CACHE_TYPE=caffeine

# --- SERVIÇO DE E-MAILS TRANSACIONAIS (RESEND) ---
# Obtenha em https://resend.com (Opcional para testes)
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev

# --- FRONTEND (NEXT.JS 16) ---
# URL pública da sua API que o navegador do usuário irá acessar:
# IMPORTANTE: No Easypanel, configure isso como Build Arg ou Variável de Ambiente do Frontend!
# Exemplo em produção: https://api.seudominio.com/api ou o domínio gerado pelo Easypanel
NEXT_PUBLIC_API_URL=http://localhost:8080/api
